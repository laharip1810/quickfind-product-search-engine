#!/bin/sh
# Minimal Maven wrapper: downloads the Maven version pinned in
# .mvn/wrapper/maven-wrapper.properties on first use, then delegates to it.
set -e
BASEDIR=$(cd "$(dirname "$0")" && pwd)
PROPS="$BASEDIR/.mvn/wrapper/maven-wrapper.properties"
DIST_URL=$(grep '^distributionUrl=' "$PROPS" | cut -d= -f2- | tr -d '\r')
DIST_NAME=$(grep '^distributionName=' "$PROPS" | cut -d= -f2- | tr -d '\r')
WRAPPER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}/wrapper/dists"
MAVEN_DIR="$WRAPPER_HOME/$DIST_NAME"

if [ ! -x "$MAVEN_DIR/bin/mvn" ]; then
  mkdir -p "$WRAPPER_HOME"
  ZIP="$WRAPPER_HOME/$DIST_NAME.zip"
  echo "Downloading $DIST_URL"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$ZIP" "$DIST_URL"
  else
    wget -q -O "$ZIP" "$DIST_URL"
  fi
  unzip -q -o "$ZIP" -d "$WRAPPER_HOME"
  rm -f "$ZIP"
  chmod +x "$MAVEN_DIR/bin/mvn"
fi

exec "$MAVEN_DIR/bin/mvn" "$@"
