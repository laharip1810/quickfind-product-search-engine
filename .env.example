# Copy this file to .env and change the passwords:  cp .env.example .env
# docker compose reads .env automatically, and the backend imports it when started with mvnw.
# Never commit .env.

# ---- Database (used by the backend and by the MySQL container) ----
DB_HOST=localhost
# Port the backend uses when it runs on your machine (mvnw). MySQL in Docker is published
# on MYSQL_HOST_PORT below; inside Docker the backend always uses mysql:3306.
DB_PORT=3307
DB_NAME=quickfind
DB_USERNAME=quickfind
DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Application ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SEED_ENABLED=true
CACHE_ENABLED=true
# Set to 1 to run without the V2 performance indexes (for before/after benchmarks).
FLYWAY_TARGET=latest

# ---- Host ports published by docker compose ----
# 3307 avoids clashing with a MySQL server already installed on your machine.
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
